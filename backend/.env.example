# AIFlow Enterprise Backend Environment Variables
# Free Tier Deployment (Render + Neon PostgreSQL + Upstash Redis)

# Core Environment
ENVIRONMENT="production"
PROJECT_NAME="AIFlow Enterprise"
API_V1_STR="/api/v1"
PORT=8000

# Security & Secret Key (Generate via: openssl rand -hex 32)
SECRET_KEY="replace_with_64_character_hex_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Neon Serverless PostgreSQL Database Connection
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<NEON_HOST>/<DB_NAME>?sslmode=require
DATABASE_URL="postgresql+asyncpg://neondb_owner:password@ep-cool-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis Connection (TLS Enabled)
# Format: rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_HOST>:6379/0
REDIS_URL="rediss://default:upstash_password@cool-redis-12345.upstash.io:6379/0"

# Allowed CORS Origins (Vercel Frontend URL)
CORS_ORIGINS=["https://aiflow.vercel.app","http://localhost:5173","http://localhost:3000"]
